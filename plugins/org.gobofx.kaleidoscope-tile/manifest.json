{
  "gobofx": "0.1",
  "id": "org.gobofx.kaleidoscope-tile",
  "name": "Kaleidoscope Tile",
  "kind": "effect",
  "category": "tiling",
  "version": "1.0.0",
  "license": "MIT OR Apache-2.0",
  "params": [
    {
      "id": "segments",
      "label": "Segments",
      "type": "int",
      "default": 6,
      "min": 1,
      "max": 16
    },
    {
      "id": "size",
      "label": "Size",
      "type": "float",
      "default": 0.35,
      "min": 0.1,
      "max": 1.0
    },
    {
      "id": "angle",
      "label": "Angle",
      "type": "float",
      "default": 0.0,
      "min": -180.0,
      "max": 180.0,
      "unit": "deg"
    }
  ],
  "passes": [
    {
      "shader": "kaleidoscope-tile.wgsl",
      "entry": "fs_main",
      "inputs": [
        "source"
      ],
      "output": "out"
    }
  ]
}
