{
  "gobofx": "0.1",
  "id": "org.gobofx.zoom-pan",
  "name": "Zoom & Pan",
  "kind": "transition",
  "category": "blur",
  "version": "1.0.0",
  "license": "MIT OR Apache-2.0",
  "params": [
    {
      "id": "direction",
      "label": "Direction",
      "type": "choice",
      "default": 0,
      "options": [
        "left to right",
        "right to left",
        "top to bottom",
        "bottom to top"
      ]
    },
    {
      "id": "zoom",
      "label": "Zoom",
      "type": "float",
      "default": 0.5,
      "min": 0.0,
      "max": 1.0
    },
    {
      "id": "blur",
      "label": "Blur",
      "type": "float",
      "default": 0.3,
      "min": 0.0,
      "max": 1.0
    },
    {
      "id": "ease",
      "label": "Ease",
      "type": "float",
      "default": 0.0,
      "min": 0.0,
      "max": 1.0
    }
  ],
  "passes": [
    {
      "shader": "zoom-pan.wgsl",
      "entry": "fs_main",
      "inputs": [
        "from",
        "to"
      ],
      "output": "out"
    }
  ]
}
