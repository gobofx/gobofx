{
  "gobofx": "0.1",
  "id": "org.gobofx.noise-dissolve",
  "name": "Noise Dissolve",
  "kind": "effect",
  "category": "stylize",
  "version": "1.0.0",
  "license": "MIT OR Apache-2.0",
  "params": [
    {
      "id": "amount",
      "label": "Amount",
      "type": "float",
      "default": 0.5,
      "min": 0.0,
      "max": 1.0
    },
    {
      "id": "size",
      "label": "Grain Size",
      "type": "float",
      "default": 3.0,
      "min": 1.0,
      "max": 32.0,
      "unit": "px"
    },
    {
      "id": "softness",
      "label": "Softness",
      "type": "float",
      "default": 0.3,
      "min": 0.0,
      "max": 1.0
    },
    {
      "id": "seed",
      "label": "Seed",
      "type": "int",
      "default": 1,
      "min": 0,
      "max": 999
    }
  ],
  "passes": [
    {
      "shader": "noise-dissolve.wgsl",
      "entry": "fs_main",
      "inputs": [
        "source"
      ],
      "output": "out"
    }
  ]
}
