{
  "gobofx": "0.1",
  "id": "org.gobofx.old-film",
  "name": "Old Film",
  "kind": "effect",
  "category": "stylize",
  "version": "1.0.0",
  "license": "MIT OR Apache-2.0",
  "params": [
    {
      "id": "scratches",
