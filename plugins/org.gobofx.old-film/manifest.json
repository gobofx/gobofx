      "min": 0.0,
      "max": 1.0
    },
    {
      "id": "jitter",
      "label": "Jitter",
      "type": "float",
      "default": 0.3,
      "min": 0.0,
      "max": 1.0
    },
    {
      "id": "grain",
      "label": "Grain",
      "type": "float",
      "default": 0.3,
      "min": 0.0,
      "max": 1.0
    },
    {
      "id": "sepia",
      "label": "Sepia",
      "type": "float",
      "default": 0.6,
      "min": 0.0,
      "max": 1.0
    },
    {
      "id": "vignette",
      "label": "Vignette",
      "type": "float",
      "default": 0.4,
      "min": 0.0,
      "max": 1.0
