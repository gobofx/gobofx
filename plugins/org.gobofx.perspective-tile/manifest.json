{
  "gobofx": "0.1",
  "id": "org.gobofx.perspective-tile",
  "name": "Perspective Tile",
  "kind": "effect",
  "category": "tiling",
  "version": "1.0.0",
  "license": "MIT OR Apache-2.0",
  "params": [
    {
      "id": "columns",
      "label": "Columns",
      "type": "int",
      "default": 4,
      "min": 1,
      "max": 12
    },
    {
      "id": "rows",
      "label": "Rows",
      "type": "int",
      "default": 3,
      "min": 1,
      "max": 12
    },
    {
      "id": "tilt",
      "label": "Tilt",
      "type": "float",
      "default": 0.85,
      "min": 0.0,
      "max": 1.0
    },
    {
      "id": "horizon",
      "label": "Horizon",
      "type": "float",
      "default": 0.3,
      "min": 0.0,
      "max": 0.9
    }
  ],
  "passes": [
    {
      "shader": "perspective-tile.wgsl",
      "entry": "fs_main",
      "inputs": [
        "source"
      ],
      "output": "out"
    }
  ]
}
