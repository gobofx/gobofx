{
  "gobofx": "0.1",
  "id": "org.gobofx.twirl",
  "name": "Twirl",
  "kind": "effect",
  "category": "distort",
  "version": "1.0.0",
  "license": "MIT OR Apache-2.0",
  "params": [
    {
      "id": "center",
      "label": "Center",
      "type": "point",
      "default": [
        0.5,
        0.5
      ]
    },
    {
      "id": "radius",
      "label": "Radius",
      "type": "float",
      "default": 0.5,
      "min": 0.05,
      "max": 2.0
    },
    {
      "id": "angle",
      "label": "Angle",
      "type": "float",
      "default": 180.0,
      "min": -720.0,
      "max": 720.0,
      "unit": "deg"
    }
  ],
  "passes": [
    {
      "shader": "twirl.wgsl",
      "entry": "fs_main",
      "inputs": [
        "source"
      ],
      "output": "out"
    }
  ]
}
