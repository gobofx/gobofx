{
  "gobofx": "0.1",
  "id": "org.gobofx.levels",
  "name": "Levels",
  "kind": "effect",
  "category": "color",
  "version": "1.0.0",
  "license": "MIT OR Apache-2.0",
  "params": [
    {
      "id": "black",
      "label": "Black Point",
      "type": "float",
      "default": 0.0,
      "min": 0.0,
      "max": 0.95
    },
    {
      "id": "white",
      "label": "White Point",
      "type": "float",
      "default": 1.0,
      "min": 0.05,
      "max": 1.0
    },
    {
      "id": "gamma",
      "label": "Gamma",
      "type": "float",
      "default": 1.0,
      "min": 0.2,
      "max": 5.0
    },
    {
      "id": "red",
      "label": "Red Offset",
      "type": "float",
      "default": 0.0,
      "min": -1.0,
      "max": 1.0
    },
    {
      "id": "green",
      "label": "Green Offset",
      "type": "float",
      "default": 0.0,
      "min": -1.0,
      "max": 1.0
    },
    {
      "id": "blue",
      "label": "Blue Offset",
      "type": "float",
      "default": 0.0,
      "min": -1.0,
      "max": 1.0
    }
  ],
  "passes": [
    {
      "shader": "levels.wgsl",
      "entry": "fs_main",
      "inputs": [
        "source"
      ],
      "output": "out"
    }
  ]
}
