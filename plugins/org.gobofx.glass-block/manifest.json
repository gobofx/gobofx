{
  "gobofx": "0.1",
  "id": "org.gobofx.glass-block",
  "name": "Glass Block",
  "kind": "effect",
  "category": "distort",
  "version": "1.0.0",
  "license": "MIT OR Apache-2.0",
  "params": [
    {
      "id": "size",
      "label": "Block Size",
      "type": "float",
      "default": 0.3,
      "min": 0.03,
      "max": 1.0
    },
    {
      "id": "amount",
      "label": "Refraction",
      "type": "float",
      "default": 0.75,
      "min": 0.0,
      "max": 1.0
    },
    {
      "id": "softness",
      "label": "Edge Softness",
      "type": "float",
      "default": 0.6,
      "min": 0.05,
      "max": 1.0
    }
  ],
  "passes": [
    {
      "shader": "glass-block.wgsl",
      "entry": "fs_main",
      "inputs": [
        "source"
      ],
      "output": "out"
    }
  ]
}
