{
  "gobofx": "0.1",
  "id": "org.gobofx.color-reduce",
  "name": "Color Reduce",
  "kind": "effect",
  "category": "color",
  "version": "1.0.0",
  "license": "MIT OR Apache-2.0",
  "params": [
    {
      "id": "levels",
      "label": "Levels",
      "type": "int",
      "default": 4,
      "min": 2,
      "max": 32
    },
    {
      "id": "dither",
      "label": "Dither",
      "type": "bool",
      "default": true
    },
    {
      "id": "amount",
      "label": "Amount",
      "type": "float",
      "default": 1.0,
      "min": 0.0,
      "max": 1.0
    }
  ],
  "passes": [
    {
      "shader": "color-reduce.wgsl",
      "entry": "fs_main",
      "inputs": [
        "source"
      ],
      "output": "out"
    }
  ]
}
