{
  "gobofx": "0.1",
  "id": "org.gobofx.fill",
  "name": "Fill",
  "kind": "effect",
  "category": "stylize",
  "version": "1.0.0",
  "license": "MIT OR Apache-2.0",
  "params": [
    {
      "id": "mode",
      "label": "Mode",
      "type": "choice",
      "default": 1,
      "options": [
        "Solid",
        "Linear Gradient"
      ]
    },
    {
      "id": "color",
      "label": "Color",
      "type": "color",
      "default": [
        1.0,
        0.15,
        0.35,
        1.0
      ]
    },
    {
      "id": "color2",
      "label": "Second Color",
      "type": "color",
      "default": [
        1.0,
        0.75,
        0.1,
        1.0
      ]
    },
    {
      "id": "angle",
      "label": "Angle",
      "type": "float",
      "default": 90.0,
      "min": 0.0,
      "max": 360.0,
      "unit": "deg"
    },
    {
      "id": "amount",
      "label": "Amount",
      "type": "float",
      "default": 1.0,
      "min": 0.0,
      "max": 1.0
    }
  ],
  "passes": [
    {
      "shader": "fill.wgsl",
      "entry": "fs_main",
      "inputs": [
        "source"
      ],
      "output": "out"
    }
  ]
}
