{
  "gobofx": "0.1",
  "id": "org.gobofx.variable-blur",
  "name": "Variable Blur",
  "kind": "effect",
  "category": "blur",
  "version": "1.0.0",
  "license": "MIT OR Apache-2.0",
  "params": [
    {
      "id": "center",
      "label": "Center",
      "type": "point",
      "default": [
        0.5,
        0.5
      ]
    },
    {
      "id": "inner",
      "label": "Inner Radius",
      "type": "float",
      "default": 0.1,
      "min": 0.0,
      "max": 2.0
    },
    {
      "id": "outer",
      "label": "Outer Radius",
      "type": "float",
      "default": 0.6,
      "min": 0.05,
      "max": 2.0
    },
    {
      "id": "radius",
      "label": "Max Blur",
      "type": "float",
      "default": 32.0,
      "min": 0.0,
      "max": 48.0,
      "unit": "px"
    }
  ],
  "passes": [
    {
      "shader": "variable-blur.wgsl",
      "entry": "fs_main",
      "constants": {
        "DIR_X": 1.0,
        "DIR_Y": 0.0
      },
      "inputs": [
        "source"
      ],
      "output": "horizontal"
    },
    {
      "shader": "variable-blur.wgsl",
      "entry": "fs_main",
      "constants": {
        "DIR_X": 0.0,
        "DIR_Y": 1.0
      },
      "inputs": [
        "horizontal"
      ],
      "output": "out"
    }
  ]
}
