{
  "gobofx": "0.1",
  "id": "org.gobofx.gradient",
  "name": "Gradient",
  "kind": "generator",
  "category": "gradient",
  "version": "1.0.0",
  "license": "MIT OR Apache-2.0",
  "params": [
    {
      "id": "style",
      "label": "Style",
      "type": "choice",
      "default": 0,
      "options": [
        "linear",
        "radial",
        "diamond"
      ]
    },
    {
      "id": "color_a",
      "label": "Color A",
      "type": "color",
      "default": [
        0.05,
        0.08,
        0.25,
        1.0
      ]
    },
    {
      "id": "color_b",
      "label": "Color B",
      "type": "color",
      "default": [
        1.0,
        0.55,
        0.15,
        1.0
      ]
    },
    {
      "id": "center",
      "label": "Center",
      "type": "point",
      "default": [
        0.5,
        0.5
      ]
    },
    {
      "id": "angle",
      "label": "Angle",
      "type": "float",
      "default": 0.0,
      "min": 0.0,
      "max": 360.0,
      "unit": "deg"
    },
    {
      "id": "span",
      "label": "Span",
      "type": "float",
      "default": 1.0,
      "min": 0.05,
      "max": 4.0
    },
    {
      "id": "midpoint",
      "label": "Midpoint",
      "type": "float",
      "default": 0.5,
      "min": 0.05,
      "max": 0.95
    },
    {
      "id": "repeat",
      "label": "Repeat",
      "type": "bool",
      "default": false
    }
  ],
  "passes": [
    {
      "shader": "gradient.wgsl",
      "entry": "fs_main",
      "inputs": [],
      "output": "out"
    }
  ]
}
