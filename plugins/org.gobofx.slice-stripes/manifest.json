{
  "gobofx": "0.1",
  "id": "org.gobofx.slice-stripes",
  "name": "Stripes",
  "kind": "effect",
  "category": "distort",
  "version": "1.0.0",
  "license": "MIT OR Apache-2.0",
  "params": [
    {
      "id": "count",
      "label": "Stripes",
      "type": "int",
      "default": 8,
      "min": 2,
      "max": 64
    },
    {
      "id": "angle",
      "label": "Angle",
      "type": "float",
      "default": 0.0,
      "min": -90.0,
      "max": 90.0,
      "unit": "deg"
    },
    {
      "id": "offset",
      "label": "Offset",
      "type": "float",
      "default": 0.08,
      "min": -0.5,
      "max": 0.5
    },
    {
      "id": "alternate",
      "label": "Alternate",
      "type": "bool",
      "default": true
    }
  ],
  "passes": [
    {
      "shader": "slice-stripes.wgsl",
      "entry": "fs_main",
      "inputs": [
        "source"
      ],
      "output": "out"
    }
  ]
}
