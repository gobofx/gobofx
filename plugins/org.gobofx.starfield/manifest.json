{
  "gobofx": "0.1",
  "id": "org.gobofx.starfield",
  "name": "Starfield",
  "kind": "generator",
  "category": "noise",
  "version": "1.0.0",
  "license": "MIT OR Apache-2.0",
  "params": [
    {
      "id": "density",
      "label": "Density",
      "type": "float",
      "default": 0.3,
      "min": 0.0,
      "max": 1.0
    },
    {
      "id": "size",
      "label": "Size",
      "type": "float",
      "default": 1.5,
      "min": 0.5,
      "max": 12.0,
      "unit": "px"
    },
    {
      "id": "speed",
      "label": "Twinkle",
      "type": "float",
      "default": 1.0,
      "min": 0.0,
      "max": 8.0
    },
    {
      "id": "color",
      "label": "Star",
      "type": "color",
      "default": [
        1.0,
        1.0,
        1.0,
        1.0
      ]
    },
    {
      "id": "background",
      "label": "Background",
      "type": "color",
      "default": [
        0.01,
        0.015,
        0.05,
        1.0
      ]
    }
  ],
  "passes": [
    {
      "shader": "starfield.wgsl",
      "entry": "fs_main",
      "inputs": [],
      "output": "out"
    }
  ]
}
