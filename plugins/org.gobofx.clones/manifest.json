{
  "gobofx": "0.1",
  "id": "org.gobofx.clones",
  "name": "Clones",
  "kind": "transition",
  "category": "clone",
  "version": "1.0.0",
  "license": "MIT OR Apache-2.0",
  "params": [
    {
      "id": "count",
      "label": "Count",
      "type": "int",
      "default": 3,
      "min": 2,
      "max": 8
    },
    {
      "id": "gap",
      "label": "Gap",
      "type": "float",
      "default": 0.1,
      "min": 0.0,
      "max": 0.4
    },
    {
      "id": "ease",
      "label": "Ease",
      "type": "float",
      "default": 0.0,
      "min": 0.0,
      "max": 1.0
    }
  ],
  "passes": [
    {
      "shader": "clones.wgsl",
      "entry": "fs_main",
      "inputs": [
        "from",
        "to"
      ],
      "output": "out"
    }
  ]
}
