{
  "gobofx": "0.1",
  "id": "org.gobofx.graduated-mask",
  "name": "Graduated Mask",
  "kind": "effect",
  "category": "masks",
  "version": "1.0.0",
  "license": "MIT OR Apache-2.0",
  "params": [
    {
      "id": "angle",
      "label": "Angle",
      "type": "float",
      "default": 0.0,
      "min": -180.0,
      "max": 180.0,
      "unit": "deg"
    },
    {
      "id": "position",
      "label": "Position",
      "type": "float",
      "default": 0.5,
      "min": 0.0,
      "max": 1.0
    },
    {
      "id": "feather",
      "label": "Feather",
      "type": "float",
      "default": 0.25,
      "min": 0.0,
      "max": 1.0
    },
    {
      "id": "invert",
      "label": "Invert",
      "type": "bool",
      "default": false
    }
  ],
  "passes": [
    {
      "shader": "graduated-mask.wgsl",
      "entry": "fs_main",
      "inputs": [
        "source"
      ],
      "output": "out"
    }
  ]
}
