{
  "gobofx": "0.1",
  "id": "org.gobofx.threshold",
  "name": "Threshold",
  "kind": "effect",
  "category": "color",
  "version": "1.0.0",
  "license": "MIT OR Apache-2.0",
  "params": [
    {
      "id": "level",
      "label": "Level",
      "type": "float",
      "default": 0.5,
      "min": 0.0,
      "max": 1.0
    },
    {
      "id": "softness",
      "label": "Softness",
      "type": "float",
      "default": 2.0,
      "min": 0.0,
      "max": 20.0,
      "unit": "px"
    },
    {
      "id": "invert",
      "label": "Invert",
      "type": "bool",
      "default": false
    },
    {
      "id": "amount",
      "label": "Amount",
      "type": "float",
      "default": 1.0,
      "min": 0.0,
      "max": 1.0
    }
  ],
  "passes": [
    {
      "shader": "threshold-mask.wgsl",
      "entry": "fs_main",
      "inputs": [
        "source"
      ],
      "output": "mask"
    },
    {
      "shader": "threshold-blur.wgsl",
      "entry": "fs_main",
      "constants": {
        "DIR_X": 1.0,
        "DIR_Y": 0.0
      },
      "inputs": [
        "mask"
      ],
      "output": "horizontal"
    },
    {
      "shader": "threshold-blur.wgsl",
      "entry": "fs_main",
      "constants": {
        "DIR_X": 0.0,
        "DIR_Y": 1.0
      },
      "inputs": [
        "horizontal"
      ],
      "output": "soft"
    },
    {
      "shader": "threshold.wgsl",
      "entry": "fs_main",
      "inputs": [
        "soft",
        "source"
      ],
      "output": "out"
    }
  ]
}
