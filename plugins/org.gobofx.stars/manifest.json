{
  "gobofx": "0.1",
  "id": "org.gobofx.stars",
  "name": "Stars",
  "kind": "transition",
  "category": "object",
  "version": "1.0.0",
  "license": "MIT OR Apache-2.0",
  "params": [
    {
      "id": "count",
      "label": "Count",
      "type": "int",
      "default": 12,
      "min": 1,
      "max": 24
    },
    {
      "id": "size",
      "label": "Size",
      "type": "float",
      "default": 1.0,
      "min": 0.25,
      "max": 3.0
    },
    {
      "id": "color",
      "label": "Color",
      "type": "color",
      "default": [
        1.0,
        0.7,
        0.08,
        1.0
      ]
    },
    {
      "id": "ease",
      "label": "Ease",
      "type": "float",
      "default": 0.0,
      "min": 0.0,
      "max": 1.0
    }
  ],
  "passes": [
    {
      "shader": "stars.wgsl",
      "entry": "fs_main",
      "inputs": [
        "from",
        "to"
      ],
      "output": "out"
    }
  ]
}
