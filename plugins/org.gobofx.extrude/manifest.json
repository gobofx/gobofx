{
  "gobofx": "0.1",
  "id": "org.gobofx.extrude",
  "name": "Extrude",
  "kind": "effect",
  "category": "stylize",
  "version": "1.0.0",
  "license": "MIT OR Apache-2.0",
  "params": [
    {
      "id": "depth",
      "label": "Depth",
      "type": "float",
      "default": 24.0,
      "min": 0.0,
      "max": 100.0,
      "unit": "px"
    },
    {
      "id": "angle",
      "label": "Angle",
      "type": "float",
      "default": 45.0,
      "min": 0.0,
      "max": 360.0,
      "unit": "deg"
    },
    {
      "id": "color",
      "label": "Color",
      "type": "color",
      "default": [
        0.25,
        0.25,
        0.25,
        1.0
      ]
    },
    {
      "id": "shading",
      "label": "Shading",
      "type": "float",
      "default": 0.6,
      "min": 0.0,
      "max": 1.0
    }
  ],
  "passes": [
    {
      "shader": "extrude.wgsl",
      "entry": "fs_main",
      "inputs": [
        "source"
      ],
      "output": "out"
    }
  ]
}
