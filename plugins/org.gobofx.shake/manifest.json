{
  "gobofx": "0.1",
  "id": "org.gobofx.shake",
  "name": "Shake",
  "kind": "effect",
  "category": "distort",
  "version": "1.0.0",
  "license": "MIT OR Apache-2.0",
  "params": [
    {
      "id": "amplitude",
      "label": "Amplitude",
      "type": "float",
      "default": 24.0,
      "min": 0.0,
      "max": 200.0,
      "unit": "px"
    },
    {
      "id": "frequency",
      "label": "Frequency",
      "type": "float",
      "default": 8.0,
      "min": 0.5,
      "max": 30.0
    },
    {
      "id": "rotation",
      "label": "Rotation",
      "type": "float",
      "default": 2.0,
      "min": 0.0,
      "max": 20.0,
      "unit": "deg"
    },
    {
      "id": "seed",
      "label": "Seed",
      "type": "int",
      "default": 1,
      "min": 0,
      "max": 999
    }
  ],
  "passes": [
    {
      "shader": "shake.wgsl",
      "entry": "fs_main",
      "inputs": [
        "source"
      ],
      "output": "out"
    }
  ]
}
