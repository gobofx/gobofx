{
  "gobofx": "0.1",
  "id": "org.gobofx.doorway",
  "name": "Doorway",
  "kind": "transition",
  "category": "movement",
  "version": "1.0.0",
  "license": "MIT OR Apache-2.0",
  "params": [
    {
      "id": "perspective",
      "label": "Perspective",
      "type": "float",
      "default": 0.5,
      "min": 0.0,
      "max": 1.0
    },
    {
      "id": "zoom",
      "label": "Zoom",
      "type": "float",
      "default": 0.1,
      "min": 0.0,
      "max": 0.5
    },
    {
      "id": "ease",
      "label": "Ease",
      "type": "float",
      "default": 0.0,
      "min": 0.0,
      "max": 1.0
    }
  ],
  "passes": [
    {
      "shader": "doorway.wgsl",
      "entry": "fs_main",
      "inputs": [
        "from",
        "to"
      ],
      "output": "out"
    }
  ]
}
