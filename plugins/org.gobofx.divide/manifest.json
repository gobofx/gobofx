{
  "gobofx": "0.1",
  "id": "org.gobofx.divide",
  "name": "Divide",
  "kind": "transition",
  "category": "dissolve",
  "version": "1.0.0",
  "license": "MIT OR Apache-2.0",
  "params": [
    {
      "id": "strips",
      "label": "Strips",
      "type": "int",
      "default": 6,
      "min": 2,
      "max": 32
    },
    {
      "id": "orientation",
      "label": "Orientation",
      "type": "choice",
      "default": 0,
      "options": [
        "horizontal",
        "vertical"
      ]
    },
    {
      "id": "stagger",
      "label": "Stagger",
      "type": "float",
      "default": 0.5,
      "min": 0.0,
      "max": 1.0
    },
    {
      "id": "ease",
      "label": "Ease",
      "type": "float",
      "default": 0.0,
      "min": 0.0,
      "max": 1.0
    }
  ],
  "passes": [
    {
      "shader": "divide.wgsl",
      "entry": "fs_main",
      "inputs": [
        "from",
        "to"
      ],
      "output": "out"
    }
  ]
}
