{
  "gobofx": "0.1",
  "id": "org.gobofx.color-adjustments",
  "name": "Color Adjustments",
  "kind": "effect",
  "category": "color",
  "version": "1.0.0",
  "license": "MIT OR Apache-2.0",
  "params": [
    {
      "id": "exposure",
      "label": "Exposure",
      "type": "float",
      "default": 0.0,
      "min": -3.0,
      "max": 3.0
    },
    {
      "id": "contrast",
      "label": "Contrast",
      "type": "float",
      "default": 1.0,
      "min": 0.0,
      "max": 2.0
    },
    {
      "id": "saturation",
      "label": "Saturation",
      "type": "float",
      "default": 1.0,
      "min": 0.0,
      "max": 2.0
    },
    {
      "id": "temperature",
      "label": "Temperature",
      "type": "float",
      "default": 0.0,
      "min": -1.0,
      "max": 1.0
    },
    {
      "id": "tint",
      "label": "Tint",
      "type": "float",
      "default": 0.0,
      "min": -1.0,
      "max": 1.0
    }
  ],
  "passes": [
    {
      "shader": "color-adjustments.wgsl",
      "entry": "fs_main",
      "inputs": [
        "source"
      ],
      "output": "out"
    }
  ]
}
