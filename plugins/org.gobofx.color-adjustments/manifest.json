{
  "gobofx": "0.1",
  "id": "org.gobofx.color-adjustments",
  "name": "Color Adjustments",
  "kind": "effect",
  "category": "color",
  "version": "1.1.0",
  "license": "MIT OR Apache-2.0",
  "params": [
    {
      "id": "exposure",
      "label": "Exposure",
      "type": "float",
      "default": 0.0,
      "min": -3.0,
      "max": 3.0
    },
    {
      "id": "contrast",
      "label": "Contrast",
      "type": "float",
      "default": 1.0,
      "min": 0.0,
      "max": 2.0
    },
    {
      "id": "saturation",
      "label": "Saturation",
      "type": "float",
      "default": 1.0,
      "min": 0.0,
      "max": 2.0
    },
    {
      "id": "temperature",
      "label": "Temperature",
      "type": "float",
      "default": 0.0,
      "min": -1.0,
      "max": 1.0
    },
    {
      "id": "tint",
      "label": "Tint",
      "type": "float",
      "default": 0.0,
      "min": -1.0,
      "max": 1.0
    }
  ],
  "passes": [
    {
      "shader": "color-adjustments.wgsl",
      "entry": "fs_main",
      "inputs": [
        "source"
      ],
      "output": "out"
    }
  ],
  "presets": [
    {
      "id": "mono",
      "name": "Mono",
      "description": "Black and white, gentle contrast",
      "params": {
        "saturation": 0.0,
        "contrast": 1.1
      }
    },
    {
      "id": "noir",
      "name": "Noir",
      "description": "High-contrast black and white, deep shadows",
      "params": {
        "saturation": 0.0,
        "contrast": 1.6,
        "exposure": -0.3
      }
    },
    {
      "id": "bleach_bypass",
      "name": "Bleach Bypass",
      "description": "Desaturated, high-contrast silver look",
      "params": {
        "saturation": 0.35,
        "contrast": 1.45,
        "exposure": 0.15
      }
    },
    {
      "id": "warm_sun",
      "name": "Warm Sun",
      "description": "Warm, bright, sunny grade",
      "params": {
        "temperature": 0.55,
        "exposure": 0.25,
        "saturation": 1.15,
        "contrast": 1.05
      }
    },
    {
      "id": "cool",
      "name": "Cool",
      "description": "Blue-shifted, slightly muted grade",
      "params": {
        "temperature": -0.5,
        "saturation": 0.9,
        "contrast": 1.05
      }
    },
    {
      "id": "chrome",
      "name": "Chrome",
      "description": "Punchy, saturated, crisp",
      "params": {
        "saturation": 1.5,
        "contrast": 1.3,
        "exposure": 0.1
      }
    },
    {
      "id": "desert",
      "name": "Desert",
      "description": "Dry, dusty, warm and flat",
      "params": {
        "temperature": 0.4,
        "tint": 0.1,
        "saturation": 0.8,
        "contrast": 0.9,
        "exposure": 0.2
      }
    },
    {
      "id": "urban",
      "name": "Urban",
      "description": "Cool, high-contrast city look",
      "params": {
        "temperature": -0.3,
        "tint": -0.1,
        "saturation": 0.85,
        "contrast": 1.35
      }
    }
  ]
}
