{
  "gobofx": "0.1",
  "id": "org.gobofx.pinwheel",
  "name": "Pinwheel",
  "kind": "transition",
  "category": "movement",
  "version": "1.0.0",
  "license": "MIT OR Apache-2.0",
  "params": [
    {
      "id": "blades",
      "label": "Blades",
      "type": "int",
      "default": 4,
      "min": 2,
      "max": 12
    },
    {
      "id": "spin",
      "label": "Spin",
      "type": "float",
      "default": 0.25,
      "min": 0.0,
      "max": 1.0
    },
    {
      "id": "softness",
      "label": "Softness",
      "type": "float",
      "default": 0.05,
      "min": 0.0,
      "max": 0.5
    },
    {
      "id": "ease",
      "label": "Ease",
      "type": "float",
      "default": 0.0,
      "min": 0.0,
      "max": 1.0
    }
  ],
  "passes": [
    {
      "shader": "pinwheel.wgsl",
      "entry": "fs_main",
      "inputs": [
        "from",
        "to"
      ],
      "output": "out"
    }
  ]
}
