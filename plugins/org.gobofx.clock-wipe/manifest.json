{
  "gobofx": "0.1",
  "id": "org.gobofx.clock-wipe",
  "name": "Clock Wipe",
  "kind": "transition",
  "category": "wipe",
  "version": "1.0.0",
  "license": "MIT OR Apache-2.0",
  "params": [
    {
      "id": "start",
      "label": "Start Angle",
      "type": "float",
      "default": 0.0,
      "min": 0.0,
      "max": 360.0,
      "unit": "deg"
    },
    {
      "id": "clockwise",
      "label": "Clockwise",
      "type": "bool",
      "default": true
    },
    {
      "id": "center",
      "label": "Center",
      "type": "point",
      "default": [
        0.5,
        0.5
      ]
    },
    {
      "id": "softness",
      "label": "Softness",
      "type": "float",
      "default": 0.01,
      "min": 0.0,
      "max": 0.2
    },
    {
      "id": "ease",
      "label": "Ease",
      "type": "float",
      "default": 0.0,
      "min": 0.0,
      "max": 1.0
    }
  ],
  "passes": [
    {
      "shader": "clock-wipe.wgsl",
      "entry": "fs_main",
      "inputs": [
        "from",
        "to"
      ],
      "output": "out"
    }
  ]
}
