{
  "gobofx": "0.1",
  "id": "org.gobofx.mosaic",
  "name": "Mosaic",
  "kind": "transition",
  "category": "movement",
  "version": "1.0.0",
  "license": "MIT OR Apache-2.0",
  "params": [
    {
      "id": "columns",
      "label": "Columns",
      "type": "int",
      "default": 8,
      "min": 2,
      "max": 32
    },
    {
      "id": "rows",
      "label": "Rows",
      "type": "int",
      "default": 0,
      "min": 0,
      "max": 32
    },
    {
      "id": "stagger",
      "label": "Stagger",
      "type": "float",
      "default": 0.6,
      "min": 0.0,
      "max": 1.0
    },
    {
      "id": "order",
      "label": "Order",
      "type": "choice",
      "default": 0,
      "options": [
        "diagonal",
        "random",
        "rows"
      ]
    },
    {
      "id": "ease",
      "label": "Ease",
      "type": "float",
      "default": 0.0,
      "min": 0.0,
      "max": 1.0
    }
  ],
  "passes": [
    {
      "shader": "mosaic.wgsl",
      "entry": "fs_main",
      "inputs": [
        "from",
        "to"
      ],
      "output": "out"
    }
  ]
}
