{
  "gobofx": "0.1",
  "id": "org.gobofx.plasma",
  "name": "Plasma",
  "kind": "generator",
  "category": "noise",
  "version": "1.0.0",
  "license": "MIT OR Apache-2.0",
  "params": [
    {
      "id": "scale",
      "label": "Scale",
      "type": "float",
      "default": 3.0,
      "min": 0.5,
      "max": 16.0
    },
    {
      "id": "speed",
      "label": "Speed",
      "type": "float",
      "default": 1.0,
      "min": 0.0,
      "max": 4.0
    },
    {
      "id": "hue",
      "label": "Hue",
      "type": "float",
      "default": 0.0,
      "min": 0.0,
      "max": 360.0,
      "unit": "deg"
    },
    {
      "id": "saturation",
      "label": "Saturation",
      "type": "float",
      "default": 0.8,
      "min": 0.0,
      "max": 1.0
    },
    {
      "id": "complexity",
      "label": "Complexity",
      "type": "float",
      "default": 1.0,
      "min": 0.5,
      "max": 3.0
    }
  ],
  "passes": [
    {
      "shader": "plasma.wgsl",
      "entry": "fs_main",
      "inputs": [],
      "output": "out"
    }
  ]
}
