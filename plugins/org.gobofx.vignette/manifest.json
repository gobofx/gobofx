{
  "gobofx": "0.1",
  "id": "org.gobofx.vignette",
  "name": "Vignette",
  "kind": "effect",
  "category": "stylize",
  "version": "1.0.0",
  "license": "MIT OR Apache-2.0",
  "params": [
    {
      "id": "strength",
      "label": "Strength",
      "type": "float",
      "default": 0.6,
      "min": 0.0,
      "max": 1.0
    },
    {
      "id": "size",
      "label": "Size",
      "type": "float",
      "default": 0.75,
      "min": 0.1,
      "max": 2.0
    },
    {
      "id": "softness",
      "label": "Softness",
      "type": "float",
      "default": 0.5,
      "min": 0.0,
      "max": 1.0
    },
    {
      "id": "roundness",
      "label": "Roundness",
      "type": "float",
      "default": 1.0,
      "min": 0.0,
      "max": 1.0
    },
    {
      "id": "center",
      "label": "Center",
      "type": "point",
      "default": [
        0.5,
        0.5
      ]
    },
    {
      "id": "color",
      "label": "Color",
      "type": "color",
      "default": [
        0.0,
        0.0,
        0.0,
        1.0
      ]
    }
  ],
  "passes": [
    {
      "shader": "vignette.wgsl",
      "entry": "fs_main",
      "inputs": [
        "source"
      ],
      "output": "out"
    }
  ]
}
