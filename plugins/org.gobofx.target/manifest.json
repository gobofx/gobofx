{
  "gobofx": "0.1",
  "id": "org.gobofx.target",
  "name": "Target",
  "kind": "effect",
  "category": "distort",
  "version": "1.0.0",
  "license": "MIT OR Apache-2.0",
  "params": [
    {
      "id": "center",
      "label": "Center",
      "type": "point",
      "default": [
        0.5,
        0.5
      ]
    },
    {
      "id": "count",
      "label": "Rings",
      "type": "int",
      "default": 6,
      "min": 2,
      "max": 24
    },
    {
      "id": "rotation",
      "label": "Rotation",
      "type": "float",
      "default": 20.0,
      "min": -90.0,
      "max": 90.0,
      "unit": "deg"
    },
    {
      "id": "alternate",
      "label": "Alternate",
      "type": "bool",
      "default": true
    }
  ],
  "passes": [
    {
      "shader": "target.wgsl",
      "entry": "fs_main",
      "inputs": [
        "source"
      ],
      "output": "out"
    }
  ]
}
