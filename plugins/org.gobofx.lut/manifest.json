{
  "gobofx": "0.1",
  "id": "org.gobofx.lut",
  "name": "LUT",
  "kind": "effect",
  "category": "color",
  "version": "1.1.0",
  "license": "MIT OR Apache-2.0",
  "params": [
    { "id": "lut", "label": "LUT", "type": "asset", "kind": "lut3d", "default": "warm", "animatable": false },
    { "id": "intensity", "label": "Intensity", "type": "float", "default": 1.0, "min": 0.0, "max": 1.0, "animatable": true },
    { "id": "input_space", "label": "Input Space", "type": "choice", "default": 0, "options": ["srgb", "linear"] }
  ],
  "assets": [
    { "id": "warm", "kind": "lut3d", "file": "warm.cube", "label": "Warm Film" },
    { "id": "identity", "kind": "lut3d", "file": "identity.cube", "label": "Identity" },
    { "id": "faded_film", "kind": "lut3d", "file": "faded-film.cube", "label": "Faded Film" },
    { "id": "cross_process", "kind": "lut3d", "file": "cross-process.cube", "label": "Cross Process" },
    { "id": "vintage", "kind": "lut3d", "file": "vintage.cube", "label": "Vintage" },
    { "id": "instant_camera", "kind": "lut3d", "file": "instant-camera.cube", "label": "Instant Camera" },
    { "id": "soft_tonal", "kind": "lut3d", "file": "soft-tonal.cube", "label": "Soft Tonal" },
    { "id": "print_transfer", "kind": "lut3d", "file": "print-transfer.cube", "label": "Print Transfer" }
  ],
  "passes": [
    { "shader": "lut.wgsl", "entry": "fs_main", "inputs": ["source", "lut"], "output": "out" }
  ],
  "presets": [
    { "id": "faded_film", "name": "Faded Film",
      "description": "Lifted blacks, low contrast, warm highlights, muted colour",
      "params": { "lut": "faded_film", "intensity": 1.0 } },
    { "id": "cross_process", "name": "Cross Process",
      "description": "Cyan shadows, yellow highlights, green midtones, hard contrast",
      "params": { "lut": "cross_process", "intensity": 0.8 } },
    { "id": "vintage", "name": "Vintage",
      "description": "Warm, faded, a magenta lean, soft highlights",
      "params": { "lut": "vintage", "intensity": 1.0 } },
    { "id": "instant_camera", "name": "Instant Camera",
      "description": "Cyan shadows, warm highlights, lifted blacks, low saturation",
      "params": { "lut": "instant_camera", "intensity": 0.8 } },
    { "id": "soft_tonal", "name": "Soft Tonal",
      "description": "Black and white with a soft S-curve and lifted blacks",
      "params": { "lut": "soft_tonal", "intensity": 1.0 } },
    { "id": "print_transfer", "name": "Print Transfer",
      "description": "Muted, a slight green cast, whites that stop short of paper white",
      "params": { "lut": "print_transfer", "intensity": 1.0 } }
  ]
}
