{
  "gobofx": "0.1",
  "id": "org.gobofx.neon",
  "name": "Neon",
  "kind": "effect",
  "category": "glow",
  "version": "1.0.0",
  "license": "MIT OR Apache-2.0",
  "params": [
    {
      "id": "color",
      "label": "Color",
      "type": "color",
      "default": [
        1.0,
        0.15,
        0.7,
        1.0
      ]
    },
    {
      "id": "radius",
      "label": "Radius",
      "type": "float",
      "default": 10.0,
      "min": 1.0,
      "max": 64.0,
      "unit": "px"
    },
    {
      "id": "intensity",
      "label": "Intensity",
      "type": "float",
      "default": 1.5,
      "min": 0.0,
      "max": 3.0
    },
    {
      "id": "darken",
      "label": "Darken",
      "type": "float",
      "default": 0.75,
      "min": 0.0,
      "max": 1.0
    }
  ],
  "passes": [
    {
      "shader": "neon.wgsl",
      "entry": "fs_edges",
      "inputs": [
        "source"
      ],
      "output": "edges"
    },
    {
      "shader": "neon.wgsl",
      "entry": "fs_blur",
      "constants": {
        "DIR_X": 1.0,
        "DIR_Y": 0.0
      },
      "inputs": [
        "edges"
      ],
      "output": "h"
    },
    {
      "shader": "neon.wgsl",
      "entry": "fs_blur",
      "constants": {
        "DIR_X": 0.0,
        "DIR_Y": 1.0
      },
      "inputs": [
        "h"
      ],
      "output": "halo"
    },
    {
      "shader": "neon.wgsl",
      "entry": "fs_compose",
      "inputs": [
        "source",
        "halo"
      ],
      "output": "out"
    }
  ]
}
