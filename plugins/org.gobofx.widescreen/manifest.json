{
  "gobofx": "0.1",
  "id": "org.gobofx.widescreen",
  "name": "Widescreen",
  "kind": "effect",
  "category": "border",
  "version": "1.0.0",
  "license": "MIT OR Apache-2.0",
  "params": [
    {
      "id": "aspect",
      "label": "Aspect",
      "type": "choice",
      "default": 0,
      "options": [
        "custom",
        "2.39:1",
        "1.85:1",
        "16:9",
        "4:3",
        "1:1"
      ]
    },
    {
      "id": "custom",
      "label": "Custom Ratio",
      "type": "float",
      "default": 2.39,
      "min": 0.5,
      "max": 4.0
    },
    {
      "id": "offset",
      "label": "Offset",
      "type": "float",
      "default": 0.0,
      "min": -1.0,
      "max": 1.0
    },
    {
      "id": "color",
      "label": "Color",
      "type": "color",
      "default": [
        0.0,
        0.0,
        0.0,
        1.0
      ]
    },
    {
      "id": "feather",
      "label": "Feather",
      "type": "float",
      "default": 0.0,
      "min": 0.0,
      "max": 8.0,
      "unit": "px"
    }
  ],
  "passes": [
    {
      "shader": "widescreen.wgsl",
      "entry": "fs_main",
      "inputs": [
        "source"
      ],
      "output": "out"
    }
  ]
}
