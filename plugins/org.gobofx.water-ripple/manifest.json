{
  "gobofx": "0.1",
  "id": "org.gobofx.water-ripple",
  "name": "Ripple",
  "kind": "effect",
  "category": "distort",
  "version": "1.0.0",
  "license": "MIT OR Apache-2.0",
  "params": [
    {
      "id": "center",
      "label": "Center",
      "type": "point",
      "default": [
        0.5,
        0.5
      ]
    },
    {
      "id": "frequency",
      "label": "Frequency",
      "type": "float",
      "default": 10.0,
      "min": 1.0,
      "max": 40.0
    },
    {
      "id": "amplitude",
      "label": "Amplitude",
      "type": "float",
      "default": 0.02,
      "min": 0.0,
      "max": 0.1
    },
    {
      "id": "speed",
      "label": "Speed",
      "type": "float",
      "default": 1.0,
      "min": -4.0,
      "max": 4.0
    }
  ],
  "passes": [
    {
      "shader": "water-ripple.wgsl",
      "entry": "fs_main",
      "inputs": [
        "source"
      ],
      "output": "out"
    }
  ]
}
