{
  "gobofx": "0.1",
  "id": "org.gobofx.spin",
  "name": "Spin",
  "kind": "transition",
  "category": "movement",
  "version": "1.0.0",
  "license": "MIT OR Apache-2.0",
  "params": [
    {
      "id": "turns",
      "label": "Turns",
      "type": "float",
      "default": 1.0,
      "min": 0.25,
      "max": 3.0
    },
    {
      "id": "zoom",
      "label": "Zoom",
      "type": "float",
      "default": 1.0,
      "min": 0.0,
      "max": 1.0
    },
    {
      "id": "center",
      "label": "Center",
      "type": "point",
      "default": [
        0.5,
        0.5
      ]
    },
    {
      "id": "ease",
      "label": "Ease",
      "type": "float",
      "default": 0.0,
      "min": 0.0,
      "max": 1.0
    }
  ],
  "passes": [
    {
      "shader": "spin.wgsl",
      "entry": "fs_main",
      "inputs": [
        "from",
        "to"
      ],
      "output": "out"
    }
  ]
}
