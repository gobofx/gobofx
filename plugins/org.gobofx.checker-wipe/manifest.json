{
  "gobofx": "0.1",
  "id": "org.gobofx.checker-wipe",
  "name": "Checker Wipe",
  "kind": "transition",
  "category": "wipe",
  "version": "1.0.0",
  "license": "MIT OR Apache-2.0",
  "params": [
    {
      "id": "columns",
      "label": "Columns",
      "type": "int",
      "default": 8,
      "min": 2,
      "max": 32
    },
    {
      "id": "rows",
      "label": "Rows",
      "type": "int",
      "default": 0,
      "min": 0,
      "max": 32
    },
    {
      "id": "spread",
      "label": "Spread",
      "type": "float",
      "default": 0.5,
      "min": 0.0,
      "max": 0.9
    },
    {
      "id": "jitter",
      "label": "Jitter",
      "type": "float",
      "default": 0.0,
      "min": 0.0,
      "max": 1.0
    },
    {
      "id": "softness",
      "label": "Softness",
      "type": "float",
      "default": 0.3,
      "min": 0.0,
      "max": 1.0
    },
    {
      "id": "ease",
      "label": "Ease",
      "type": "float",
      "default": 0.0,
      "min": 0.0,
      "max": 1.0
    }
  ],
  "passes": [
    {
      "shader": "checker-wipe.wgsl",
      "entry": "fs_main",
      "inputs": [
        "from",
        "to"
      ],
      "output": "out"
    }
  ]
}
