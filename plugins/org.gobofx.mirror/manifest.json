{
  "gobofx": "0.1",
  "id": "org.gobofx.mirror",
  "name": "Mirror",
  "kind": "effect",
  "category": "distort",
  "version": "1.0.0",
  "license": "MIT OR Apache-2.0",
  "params": [
    {
      "id": "axis",
      "label": "Axis",
      "type": "choice",
      "default": 0,
      "options": [
        "vertical",
        "horizontal",
        "both"
      ]
    },
    {
      "id": "position",
      "label": "Position",
      "type": "float",
      "default": 0.5,
      "min": 0.0,
      "max": 1.0
    },
    {
      "id": "keep",
      "label": "Keep",
      "type": "choice",
      "default": 0,
      "options": [
        "left or top",
        "right or bottom"
      ]
    }
  ],
  "passes": [
    {
      "shader": "mirror.wgsl",
      "entry": "fs_main",
      "inputs": [
        "source"
      ],
      "output": "out"
    }
  ]
}
