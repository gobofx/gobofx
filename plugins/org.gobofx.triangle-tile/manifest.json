{
  "gobofx": "0.1",
  "id": "org.gobofx.triangle-tile",
  "name": "Triangle Tile",
  "kind": "effect",
  "category": "tiling",
  "version": "1.0.0",
  "license": "MIT OR Apache-2.0",
  "params": [
    {
      "id": "size",
      "label": "Size",
      "type": "float",
      "default": 0.22,
      "min": 0.08,
      "max": 0.6
    },
    {
      "id": "angle",
      "label": "Angle",
      "type": "float",
      "default": 0.0,
      "min": -180.0,
      "max": 180.0,
      "unit": "deg"
    }
  ],
  "passes": [
    {
      "shader": "triangle-tile.wgsl",
      "entry": "fs_main",
      "inputs": [
        "source"
      ],
      "output": "out"
    }
  ]
}
