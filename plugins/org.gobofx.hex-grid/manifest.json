{
  "gobofx": "0.1",
  "id": "org.gobofx.hex-grid",
  "name": "Hex Grid",
  "kind": "generator",
  "category": "pattern",
  "version": "1.0.0",
  "license": "MIT OR Apache-2.0",
  "params": [
    {
      "id": "size",
      "label": "Cell Size",
      "type": "float",
      "default": 0.14,
      "min": 0.02,
      "max": 1.0
    },
    {
      "id": "line_width",
      "label": "Line Width",
      "type": "float",
      "default": 2.0,
      "min": 0.5,
      "max": 32.0,
      "unit": "px"
    },
    {
      "id": "color",
      "label": "Line",
      "type": "color",
      "default": [
        0.2,
        0.75,
        0.9,
        1.0
      ]
    },
    {
      "id": "fill",
      "label": "Fill",
      "type": "color",
      "default": [
        0.0,
        0.0,
        0.0,
        0.0
      ]
    },
    {
      "id": "center",
      "label": "Center",
      "type": "point",
      "default": [
        0.5,
        0.5
      ]
    },
    {
      "id": "angle",
      "label": "Angle",
      "type": "float",
      "default": 0.0,
      "min": -180.0,
      "max": 180.0,
      "unit": "deg"
    }
  ],
  "passes": [
    {
      "shader": "hex-grid.wgsl",
      "entry": "fs_main",
      "inputs": [],
      "output": "out"
    }
  ]
}
