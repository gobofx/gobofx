{
  "gobofx": "0.1",
  "id": "org.gobofx.clouds",
  "name": "Clouds",
  "kind": "generator",
  "category": "noise",
  "version": "1.0.0",
  "license": "MIT OR Apache-2.0",
  "params": [
    {
      "id": "scale",
      "label": "Scale",
      "type": "float",
      "default": 2.5,
      "min": 0.5,
      "max": 16.0
    },
    {
      "id": "octaves",
      "label": "Octaves",
      "type": "int",
      "default": 4,
      "min": 1,
      "max": 6
    },
    {
      "id": "speed",
      "label": "Speed",
      "type": "float",
      "default": 0.3,
      "min": 0.0,
      "max": 4.0
    },
    {
      "id": "coverage",
      "label": "Coverage",
      "type": "float",
      "default": 0.5,
      "min": 0.0,
      "max": 1.0
    },
    {
      "id": "softness",
      "label": "Softness",
      "type": "float",
      "default": 0.5,
      "min": 0.0,
      "max": 1.0
    },
    {
      "id": "color_a",
      "label": "Sky",
      "type": "color",
      "default": [
        0.2,
        0.45,
        0.9,
        1.0
      ]
    },
    {
      "id": "color_b",
      "label": "Cloud",
      "type": "color",
      "default": [
        1.0,
        1.0,
        1.0,
        1.0
      ]
    }
  ],
  "passes": [
    {
      "shader": "clouds.wgsl",
      "entry": "fs_main",
      "inputs": [],
      "output": "out"
    }
  ]
}
