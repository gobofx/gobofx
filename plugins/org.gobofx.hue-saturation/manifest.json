{
  "gobofx": "0.1",
  "id": "org.gobofx.hue-saturation",
  "name": "Hue/Saturation",
  "kind": "effect",
  "category": "color",
  "version": "1.0.0",
  "license": "MIT OR Apache-2.0",
  "params": [
    {
      "id": "hue",
      "label": "Hue",
      "type": "float",
      "default": 0.0,
      "min": -180.0,
      "max": 180.0,
      "unit": "deg"
    },
    {
      "id": "saturation",
      "label": "Saturation",
      "type": "float",
      "default": 1.0,
      "min": 0.0,
      "max": 2.0
    },
    {
      "id": "value",
      "label": "Value",
      "type": "float",
      "default": 1.0,
      "min": 0.0,
      "max": 2.0
    }
  ],
  "passes": [
    {
      "shader": "hue-saturation.wgsl",
      "entry": "fs_main",
      "inputs": [
        "source"
      ],
      "output": "out"
    }
  ]
}
