{
  "gobofx": "0.1",
  "id": "org.gobofx.vignette-mask",
  "name": "Vignette Mask",
  "kind": "effect",
  "category": "masks",
  "version": "1.0.0",
  "license": "MIT OR Apache-2.0",
  "params": [
    {
      "id": "center",
      "label": "Center",
      "type": "point",
      "default": [
        0.5,
        0.5
      ]
    },
    {
      "id": "size",
      "label": "Size",
      "type": "float",
      "default": 0.85,
      "min": 0.05,
      "max": 2.0
    },
    {
      "id": "aspect",
      "label": "Aspect",
      "type": "float",
      "default": 0.6,
      "min": 0.1,
      "max": 3.0
    },
    {
      "id": "feather",
      "label": "Feather",
      "type": "float",
      "default": 0.2,
      "min": 0.0,
      "max": 1.0
    },
    {
      "id": "invert",
      "label": "Invert",
      "type": "bool",
      "default": false
    }
  ],
  "passes": [
    {
      "shader": "vignette-mask.wgsl",
      "entry": "fs_main",
      "inputs": [
        "source"
      ],
      "output": "out"
    }
  ]
}
