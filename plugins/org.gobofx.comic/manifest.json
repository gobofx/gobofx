{
  "gobofx": "0.1",
  "id": "org.gobofx.comic",
  "name": "Comic",
  "kind": "effect",
  "category": "stylize",
  "version": "1.0.0",
  "license": "MIT OR Apache-2.0",
  "params": [
    {
      "id": "levels",
      "label": "Levels",
      "type": "int",
      "default": 5,
      "min": 2,
      "max": 16
    },
    {
      "id": "threshold",
      "label": "Edge Threshold",
      "type": "float",
      "default": 0.15,
      "min": 0.0,
      "max": 1.0
    },
    {
      "id": "ink",
      "label": "Ink",
      "type": "color",
      "default": [
        0.0,
        0.0,
        0.0,
        1.0
      ]
    },
    {
      "id": "amount",
      "label": "Amount",
      "type": "float",
      "default": 1.0,
      "min": 0.0,
      "max": 1.0
    }
  ],
  "passes": [
    {
      "shader": "comic.wgsl",
      "entry": "fs_main",
      "inputs": [
        "source"
      ],
      "output": "out"
    }
  ]
}
