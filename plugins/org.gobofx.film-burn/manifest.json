{
  "gobofx": "0.1",
  "id": "org.gobofx.film-burn",
  "name": "Film Burn",
  "kind": "generator",
  "category": "light",
  "version": "1.0.0",
  "license": "MIT OR Apache-2.0",
  "params": [
    {
      "id": "amount",
      "label": "Amount",
      "type": "float",
      "default": 0.4,
      "min": 0.0,
      "max": 1.0
    },
    {
      "id": "glow",
      "label": "Edge Glow",
      "type": "float",
      "default": 0.5,
      "min": 0.0,
      "max": 1.0
    },
    {
      "id": "speed",
      "label": "Speed",
      "type": "float",
      "default": 1.0,
      "min": 0.0,
      "max": 4.0
    },
    {
      "id": "color",
      "label": "Color",
      "type": "color",
      "default": [
        1.0,
        0.5,
        0.1,
        1.0
      ]
    },
    {
      "id": "angle",
      "label": "Angle",
      "type": "float",
      "default": 0.0,
      "min": -180.0,
      "max": 180.0,
      "unit": "deg"
    }
  ],
  "passes": [
    {
      "shader": "film-burn.wgsl",
      "entry": "fs_main",
      "inputs": [],
      "output": "out"
    }
  ]
}
