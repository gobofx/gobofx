{
  "gobofx": "0.1",
  "id": "org.gobofx.gradient-blur",
  "name": "Gradient Blur",
  "kind": "effect",
  "category": "blur",
  "version": "1.0.0",
  "license": "MIT OR Apache-2.0",
  "params": [
    {
      "id": "position",
      "label": "Band Position",
      "type": "float",
      "default": 0.5,
      "min": 0.0,
      "max": 1.0
    },
    {
      "id": "width",
      "label": "Band Width",
      "type": "float",
      "default": 0.2,
      "min": 0.0,
      "max": 1.0
    },
    {
      "id": "feather",
      "label": "Feather",
      "type": "float",
      "default": 0.25,
      "min": 0.0,
      "max": 1.0
    },
    {
      "id": "radius",
      "label": "Radius",
      "type": "float",
      "default": 24.0,
      "min": 0.0,
      "max": 48.0,
      "unit": "px"
    },
    {
      "id": "angle",
      "label": "Angle",
      "type": "float",
      "default": 0.0,
      "min": -90.0,
      "max": 90.0,
      "unit": "deg"
    }
  ],
  "passes": [
    {
      "shader": "gradient-blur.wgsl",
      "entry": "fs_main",
      "constants": {
        "DIR_X": 1.0,
        "DIR_Y": 0.0
      },
      "inputs": [
        "source"
      ],
      "output": "horizontal"
    },
    {
      "shader": "gradient-blur.wgsl",
      "entry": "fs_main",
      "constants": {
        "DIR_X": 0.0,
        "DIR_Y": 1.0
      },
      "inputs": [
        "horizontal"
      ],
      "output": "out"
    }
  ]
}
