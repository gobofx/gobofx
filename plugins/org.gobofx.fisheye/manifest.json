{
  "gobofx": "0.1",
  "id": "org.gobofx.fisheye",
  "name": "Fisheye",
  "kind": "effect",
  "category": "distort",
  "version": "1.0.0",
  "license": "MIT OR Apache-2.0",
  "params": [
    {
      "id": "center",
      "label": "Center",
      "type": "point",
      "default": [
        0.5,
        0.5
      ]
    },
    {
      "id": "amount",
      "label": "Amount",
      "type": "float",
      "default": 0.5,
      "min": 0.0,
      "max": 1.0
    },
    {
      "id": "zoom",
      "label": "Zoom",
      "type": "float",
      "default": 1.0,
      "min": 1.0,
      "max": 2.0
    }
  ],
  "passes": [
    {
      "shader": "fisheye.wgsl",
      "entry": "fs_main",
      "inputs": [
        "source"
      ],
      "output": "out"
    }
  ]
}
