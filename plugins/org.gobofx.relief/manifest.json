{
  "gobofx": "0.1",
  "id": "org.gobofx.relief",
  "name": "Relief",
  "kind": "effect",
  "category": "stylize",
  "version": "1.0.0",
  "license": "MIT OR Apache-2.0",
  "params": [
    {
      "id": "angle",
      "label": "Light Angle",
      "type": "float",
      "default": 135.0,
      "min": 0.0,
      "max": 360.0,
      "unit": "deg"
    },
    {
      "id": "height",
      "label": "Height",
      "type": "float",
      "default": 2.0,
      "min": 0.0,
      "max": 8.0,
      "unit": "px"
    },
    {
      "id": "amount",
      "label": "Amount",
      "type": "float",
      "default": 1.0,
      "min": 0.0,
      "max": 1.0
    }
  ],
  "passes": [
    {
      "shader": "relief.wgsl",
      "entry": "fs_main",
      "inputs": [
        "source"
      ],
      "output": "out"
    }
  ]
}
