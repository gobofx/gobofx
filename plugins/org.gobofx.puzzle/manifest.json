{
  "gobofx": "0.1",
  "id": "org.gobofx.puzzle",
  "name": "Puzzle",
  "kind": "transition",
  "category": "movement",
  "version": "1.0.0",
  "license": "MIT OR Apache-2.0",
  "params": [
    {
      "id": "columns",
      "label": "Columns",
      "type": "int",
      "default": 6,
      "min": 2,
      "max": 16
    },
    {
      "id": "scatter",
      "label": "Scatter",
      "type": "float",
      "default": 0.6,
      "min": 0.0,
      "max": 1.0
    },
    {
      "id": "stagger",
      "label": "Stagger",
      "type": "float",
      "default": 0.5,
      "min": 0.0,
      "max": 1.0
    },
    {
      "id": "ease",
      "label": "Ease",
      "type": "float",
      "default": 0.0,
      "min": 0.0,
      "max": 1.0
    }
  ],
  "passes": [
    {
      "shader": "puzzle.wgsl",
      "entry": "fs_main",
      "inputs": [
        "from",
        "to"
      ],
      "output": "out"
    }
  ]
}
