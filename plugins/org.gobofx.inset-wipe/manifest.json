{
  "gobofx": "0.1",
  "id": "org.gobofx.inset-wipe",
  "name": "Inset Wipe",
  "kind": "transition",
  "category": "wipe",
  "version": "1.0.0",
  "license": "MIT OR Apache-2.0",
  "params": [
    {
      "id": "corner",
      "label": "Corner",
      "type": "choice",
      "default": 0,
      "options": [
        "top left",
        "top right",
        "bottom left",
        "bottom right",
        "center"
      ]
    },
    {
      "id": "softness",
      "label": "Softness",
      "type": "float",
      "default": 0.02,
      "min": 0.0,
      "max": 0.3
    },
    {
      "id": "ease",
      "label": "Ease",
      "type": "float",
      "default": 0.0,
      "min": 0.0,
      "max": 1.0
    }
  ],
  "passes": [
    {
      "shader": "inset-wipe.wgsl",
      "entry": "fs_main",
      "inputs": [
        "from",
        "to"
      ],
      "output": "out"
    }
  ]
}
