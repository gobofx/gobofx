{
  "gobofx": "0.1",
  "id": "org.gobofx.gradient-colorize",
  "name": "Gradient Colorize",
  "kind": "effect",
  "category": "color",
  "version": "1.0.0",
  "license": "MIT OR Apache-2.0",
  "params": [
    {
      "id": "color_a",
      "label": "Blacks",
      "type": "color",
      "default": [0.02, 0.0, 0.1, 1.0]
    },
    {
      "id": "color_b",
      "label": "Midtones",
      "type": "color",
      "default": [0.9, 0.12, 0.02, 1.0]
    },
    {
      "id": "color_c",
      "label": "Whites",
      "type": "color",
      "default": [1.0, 0.95, 0.6, 1.0]
    },
    {
      "id": "mid",
      "label": "Mid Position",
      "type": "float",
      "default": 0.5,
      "min": 0.05,
      "max": 0.95
    },
    {
      "id": "amount",
      "label": "Amount",
      "type": "float",
      "default": 1.0,
      "min": 0.0,
      "max": 1.0
    }
  ],
  "passes": [
    {
      "shader": "gradient-colorize.wgsl",
      "entry": "fs_main",
      "inputs": [
        "source"
      ],
      "output": "out"
    }
  ]
}
