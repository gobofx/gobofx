{
  "gobofx": "0.1",
  "id": "org.gobofx.billboard",
  "name": "Billboard",
  "kind": "transition",
  "category": "stylized",
  "version": "1.0.0",
  "license": "MIT OR Apache-2.0",
  "params": [
    {
      "id": "count",
      "label": "Count",
      "type": "int",
      "default": 8,
      "min": 2,
      "max": 24
    },
    {
      "id": "stagger",
      "label": "Stagger",
      "type": "float",
      "default": 0.5,
      "min": 0.0,
      "max": 1.0
    },
    {
      "id": "perspective",
      "label": "Perspective",
      "type": "float",
      "default": 0.5,
      "min": 0.0,
      "max": 1.0
    },
    {
      "id": "ease",
      "label": "Ease",
      "type": "float",
      "default": 0.0,
      "min": 0.0,
      "max": 1.0
    }
  ],
  "passes": [
    {
      "shader": "billboard.wgsl",
      "entry": "fs_main",
      "inputs": [
        "from",
        "to"
      ],
      "output": "out"
    }
  ]
}
