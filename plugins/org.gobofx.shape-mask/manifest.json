{
  "gobofx": "0.1",
  "id": "org.gobofx.shape-mask",
  "name": "Shape Mask",
  "kind": "effect",
  "category": "masks",
  "version": "1.0.0",
  "license": "MIT OR Apache-2.0",
  "params": [
    {
      "id": "shape",
      "label": "Shape",
      "type": "choice",
      "default": 0,
      "options": [
        "rectangle",
        "ellipse"
      ]
    },
    {
      "id": "center",
      "label": "Center",
      "type": "point",
      "default": [
        0.5,
        0.5
      ]
    },
    {
      "id": "width",
      "label": "Width",
      "type": "float",
      "default": 0.8,
      "min": 0.02,
      "max": 3.0
    },
    {
      "id": "height",
      "label": "Height",
      "type": "float",
      "default": 0.6,
      "min": 0.02,
      "max": 3.0
    },
    {
      "id": "roundness",
      "label": "Roundness",
      "type": "float",
      "default": 0.2,
      "min": 0.0,
      "max": 1.0
    },
    {
      "id": "feather",
      "label": "Feather",
      "type": "float",
      "default": 0.05,
      "min": 0.0,
      "max": 0.5
    },
    {
      "id": "rotation",
      "label": "Rotation",
      "type": "float",
      "default": 0.0,
      "min": -180.0,
      "max": 180.0,
      "unit": "deg"
    },
    {
      "id": "invert",
      "label": "Invert",
      "type": "bool",
      "default": false
    }
  ],
  "passes": [
    {
      "shader": "shape-mask.wgsl",
      "entry": "fs_main",
      "inputs": [
        "source"
      ],
      "output": "out"
    }
  ]
}
