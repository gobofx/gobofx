{
  "gobofx": "0.1",
  "id": "org.gobofx.film-grain",
  "name": "Film Grain",
  "kind": "effect",
  "category": "stylize",
  "version": "1.0.0",
  "license": "MIT OR Apache-2.0",
  "params": [
    {
      "id": "amount",
      "label": "Amount",
      "type": "float",
      "default": 0.3,
      "min": 0.0,
      "max": 1.0
    },
    {
      "id": "size",
      "label": "Size",
      "type": "float",
      "default": 1.5,
      "min": 1.0,
      "max": 8.0,
      "unit": "px"
    },
    {
      "id": "color",
      "label": "Color Grain",
      "type": "bool",
      "default": false
    },
    {
      "id": "shadows",
      "label": "Shadows",
      "type": "float",
      "default": 0.5,
      "min": 0.0,
      "max": 1.0
    }
  ],
  "passes": [
    {
      "shader": "film-grain.wgsl",
      "entry": "fs_main",
      "inputs": [
        "source"
      ],
      "output": "out"
    }
  ]
}
