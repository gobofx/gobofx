{
  "gobofx": "0.1",
  "id": "org.gobofx.parallelogram-tile",
  "name": "Parallelogram Tile",
  "kind": "effect",
  "category": "tiling",
  "version": "1.0.0",
  "license": "MIT OR Apache-2.0",
  "params": [
    {
      "id": "columns",
      "label": "Columns",
      "type": "int",
      "default": 3,
      "min": 1,
      "max": 12
    },
    {
      "id": "rows",
      "label": "Rows",
      "type": "int",
      "default": 2,
      "min": 1,
      "max": 12
    },
    {
      "id": "skew",
      "label": "Skew",
      "type": "float",
      "default": 0.5,
      "min": -1.0,
      "max": 1.0
    }
  ],
  "passes": [
    {
      "shader": "parallelogram-tile.wgsl",
      "entry": "fs_main",
      "inputs": [
        "source"
      ],
      "output": "out"
    }
  ]
}
