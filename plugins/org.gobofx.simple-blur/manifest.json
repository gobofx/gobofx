{
  "gobofx": "0.1",
  "id": "org.gobofx.simple-blur",
  "name": "Simple",
  "kind": "transition",
  "category": "blur",
  "version": "1.0.0",
  "license": "MIT OR Apache-2.0",
  "params": [
    {
      "id": "radius",
      "label": "Radius",
      "type": "float",
      "default": 24.0,
      "min": 0.0,
      "max": 64.0,
      "unit": "px"
    },
    {
      "id": "ease",
      "label": "Ease",
      "type": "float",
      "default": 0.0,
      "min": 0.0,
      "max": 1.0
    }
  ],
  "passes": [
    {
      "shader": "simple-blur.wgsl",
      "entry": "fs_mix",
      "inputs": [
        "from",
        "to"
      ],
      "output": "mixed"
    },
    {
      "shader": "simple-blur.wgsl",
      "entry": "fs_blur",
      "constants": {
        "DIR_X": 1.0,
        "DIR_Y": 0.0
      },
      "inputs": [
        "mixed"
      ],
      "output": "mixed_h"
    },
    {
      "shader": "simple-blur.wgsl",
      "entry": "fs_blur",
      "constants": {
        "DIR_X": 0.0,
        "DIR_Y": 1.0
      },
      "inputs": [
        "mixed_h"
      ],
      "output": "out"
    }
  ]
}
