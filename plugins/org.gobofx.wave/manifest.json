{
  "gobofx": "0.1",
  "id": "org.gobofx.wave",
  "name": "Wave",
  "kind": "effect",
  "category": "distort",
  "version": "1.0.0",
  "license": "MIT OR Apache-2.0",
  "params": [
    {
      "id": "amplitude",
      "label": "Amplitude",
      "type": "float",
      "default": 0.03,
      "min": 0.0,
      "max": 0.2
    },
    {
      "id": "wavelength",
      "label": "Wavelength",
      "type": "float",
      "default": 0.3,
      "min": 0.05,
      "max": 2.0
    },
    {
      "id": "direction",
      "label": "Direction",
      "type": "choice",
      "default": 0,
      "options": [
        "horizontal",
        "vertical",
        "both"
      ]
    },
    {
      "id": "phase",
      "label": "Phase",
      "type": "float",
      "default": 0.0,
      "min": 0.0,
      "max": 360.0,
      "unit": "deg"
    },
    {
      "id": "speed",
      "label": "Speed",
      "type": "float",
      "default": 1.0,
      "min": -4.0,
      "max": 4.0
    }
  ],
  "passes": [
    {
      "shader": "wave.wgsl",
      "entry": "fs_main",
      "inputs": [
        "source"
      ],
      "output": "out"
    }
  ]
}
