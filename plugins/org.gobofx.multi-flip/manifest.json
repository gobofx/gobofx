{
  "gobofx": "0.1",
  "id": "org.gobofx.multi-flip",
  "name": "Multi-Flip",
  "kind": "transition",
  "category": "clone",
  "version": "1.0.0",
  "license": "MIT OR Apache-2.0",
  "params": [
    {
      "id": "columns",
      "label": "Columns",
      "type": "int",
      "default": 6,
      "min": 2,
      "max": 32
    },
    {
      "id": "rows",
      "label": "Rows",
      "type": "int",
      "default": 0,
      "min": 0,
      "max": 32
    },
    {
      "id": "axis",
      "label": "Axis",
      "type": "choice",
      "default": 0,
      "options": [
        "vertical axis",
        "horizontal axis",
        "alternate"
      ]
    },
    {
      "id": "origin",
      "label": "Origin",
      "type": "point",
      "default": [
        0.5,
        0.5
      ]
    },
    {
      "id": "stagger",
      "label": "Stagger",
      "type": "float",
      "default": 0.6,
      "min": 0.0,
      "max": 1.0
    },
    {
      "id": "perspective",
      "label": "Perspective",
      "type": "float",
      "default": 0.5,
      "min": 0.0,
      "max": 1.0
    },
    {
      "id": "ease",
      "label": "Ease",
      "type": "float",
      "default": 0.0,
      "min": 0.0,
      "max": 1.0
    }
  ],
  "passes": [
    {
      "shader": "multi-flip.wgsl",
      "entry": "fs_main",
      "inputs": [
        "from",
        "to"
      ],
      "output": "out"
    }
  ]
}
