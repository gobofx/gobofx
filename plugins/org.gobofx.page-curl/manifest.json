{
  "gobofx": "0.1",
  "id": "org.gobofx.page-curl",
  "name": "Page Curl",
  "kind": "transition",
  "category": "movement",
  "version": "1.0.0",
  "license": "MIT OR Apache-2.0",
  "params": [
    {
      "id": "corner",
      "label": "Corner",
      "type": "choice",
      "default": 0,
      "options": [
        "bottom right",
        "bottom left",
        "top right",
        "top left"
      ]
    },
    {
      "id": "radius",
      "label": "Radius",
      "type": "float",
      "default": 0.15,
      "min": 0.05,
      "max": 0.5
    },
    {
      "id": "ease",
      "label": "Ease",
      "type": "float",
      "default": 0.0,
      "min": 0.0,
      "max": 1.0
    }
  ],
  "passes": [
    {
      "shader": "page-curl.wgsl",
      "entry": "fs_main",
      "inputs": [
        "from",
        "to"
      ],
      "output": "out"
    }
  ]
}
