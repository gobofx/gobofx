{
  "gobofx": "0.1",
  "id": "org.gobofx.channel-mixer",
  "name": "Channel Mixer",
  "kind": "effect",
  "category": "color",
  "version": "1.0.0",
  "license": "MIT OR Apache-2.0",
  "params": [
    {
      "id": "red_red",
      "label": "Red from Red",
      "type": "float",
      "default": 1.0,
      "min": -2.0,
      "max": 2.0
    },
    {
      "id": "red_green",
      "label": "Red from Green",
      "type": "float",
      "default": 0.0,
      "min": -2.0,
      "max": 2.0
    },
    {
      "id": "red_blue",
      "label": "Red from Blue",
      "type": "float",
      "default": 0.0,
      "min": -2.0,
      "max": 2.0
    },
    {
      "id": "green_red",
      "label": "Green from Red",
      "type": "float",
      "default": 0.0,
      "min": -2.0,
      "max": 2.0
    },
    {
      "id": "green_green",
      "label": "Green from Green",
      "type": "float",
      "default": 1.0,
      "min": -2.0,
      "max": 2.0
    },
    {
      "id": "green_blue",
      "label": "Green from Blue",
      "type": "float",
      "default": 0.0,
      "min": -2.0,
      "max": 2.0
    },
    {
      "id": "blue_red",
      "label": "Blue from Red",
      "type": "float",
      "default": 0.0,
      "min": -2.0,
      "max": 2.0
    },
    {
      "id": "blue_green",
      "label": "Blue from Green",
      "type": "float",
      "default": 0.0,
      "min": -2.0,
      "max": 2.0
    },
    {
      "id": "blue_blue",
      "label": "Blue from Blue",
      "type": "float",
      "default": 1.0,
      "min": -2.0,
      "max": 2.0
    },
    {
      "id": "monochrome",
      "label": "Monochrome",
      "type": "bool",
      "default": false
    }
  ],
  "passes": [
    {
      "shader": "channel-mixer.wgsl",
      "entry": "fs_main",
      "inputs": [
        "source"
      ],
      "output": "out"
    }
  ]
}
