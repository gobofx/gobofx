{
  "gobofx": "0.1",
  "id": "org.gobofx.circle-screen",
  "name": "Circle Screen",
  "kind": "effect",
  "category": "stylize",
  "version": "1.0.0",
  "license": "MIT OR Apache-2.0",
  "params": [
    {
      "id": "center",
      "label": "Center",
      "type": "point",
      "default": [
        0.5,
        0.5
      ]
    },
    {
      "id": "size",
      "label": "Ring Pitch",
      "type": "float",
      "default": 8.0,
      "min": 2.0,
      "max": 64.0,
      "unit": "px"
    },
    {
      "id": "ink",
      "label": "Ink",
      "type": "color",
      "default": [
        0.0,
        0.0,
        0.0,
        1.0
      ]
    },
    {
      "id": "paper",
      "label": "Paper",
      "type": "color",
      "default": [
        1.0,
        1.0,
        1.0,
        1.0
      ]
    },
    {
      "id": "amount",
      "label": "Amount",
      "type": "float",
      "default": 1.0,
      "min": 0.0,
      "max": 1.0
    }
  ],
  "passes": [
    {
      "shader": "circle-screen.wgsl",
      "entry": "fs_main",
      "inputs": [
        "source"
      ],
      "output": "out"
    }
  ]
}
