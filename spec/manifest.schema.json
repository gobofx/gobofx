{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gobofx.org/schema/0.1/manifest.json",
  "title": "GoboFX manifest v0.1",
  "type": "object",
  "required": [
    "gobofx",
    "id",
    "name",
    "kind",
    "version",
    "passes"
  ],
  "additionalProperties": false,
  "properties": {
    "gobofx": {
      "const": "0.1"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(\\.[a-z0-9-]+)+$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "kind": {
      "enum": [
        "effect",
        "transition"
      ]
    },
    "category": {
      "type": "string"
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+(-[0-9A-Za-z.-]+)?$"
    },
    "license": {
      "type": "string"
    },
    "params": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/param"
      }
    },
    "passes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/pass"
      }
    },
    "signals": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/signal"
      }
    }
  },
  "$defs": {
    "param": {
      "type": "object",
      "required": [
        "id",
        "type"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z_][a-z0-9_]*$"
        },
        "label": {
          "type": "string"
        },
        "type": {
          "enum": [
            "float",
            "int",
            "bool",
            "choice",
            "color",
            "point"
          ]
        },
        "default": {},
        "min": {
          "type": "number"
        },
        "max": {
          "type": "number"
        },
        "unit": {
          "type": "string"
        },
        "options": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "animatable": {
          "type": "boolean",
          "default": true
        }
      }
    },
    "pass": {
      "type": "object",
      "required": [
        "shader",
        "entry",
        "inputs",
        "output"
      ],
      "additionalProperties": false,
      "properties": {
        "shader": {
          "type": "string",
          "pattern": "\\.wgsl$"
        },
        "entry": {
          "type": "string"
        },
        "constants": {
          "type": "object",
          "additionalProperties": {
            "type": [
              "number",
              "boolean"
            ]
          }
        },
        "inputs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 2,
          "items": {
            "type": "string"
          }
        },
        "output": {
          "type": "string"
        }
      }
    },
    "signal": {
      "type": "object",
      "required": [
        "id"
      ],
      "additionalProperties": false,
      "oneOf": [
        {
          "required": [
            "cc"
          ]
        },
        {
          "required": [
            "note"
          ]
        }
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z_][a-z0-9_]*$"
        },
        "label": {
          "type": "string"
        },
        "cc": {
          "type": "integer",
          "minimum": 0,
          "maximum": 127
        },
        "note": {
          "type": "integer",
          "minimum": 0,
          "maximum": 127
        },
        "mode": {
          "enum": [
            "gate",
            "velocity"
          ]
        },
        "channel": {
          "type": "integer",
          "minimum": 1,
          "maximum": 16
        },
        "hint": {
          "type": "string"
        },
        "default": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "attack_ms": {
          "type": "number",
          "minimum": 0
        },
        "release_ms": {
          "type": "number",
          "minimum": 0
        }
      }
    }
  }
}
