{
  "wisp": "0.1",
  "id": "org.wispfx.cross-dissolve",
  "name": "Cross Dissolve",
  "kind": "transition",
  "category": "dissolve",
  "version": "0.1.0",
  "license": "MIT OR Apache-2.0",
  "params": [
    {
      "id": "ease",
      "label": "Ease",
