{
  "name": "@gobofx/site",
  "version": "0.0.2",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm run build:wasm && vite dev",
    "build": "pnpm run build:wasm && vite build",
    "preview": "wrangler dev",
    "deploy": "pnpm run build && wrangler deploy",
    "cf-typegen": "wrangler types",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --threshold warning",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "build:wasm": "cd ../.. && cargo build -p gobofx --lib --release --target wasm32-unknown-unknown --no-default-features && wasm-bindgen --target web --out-dir apps/site/src/lib/wasm --out-name gobofx target/wasm32-unknown-unknown/release/gobofx.wasm"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250101.0",
    "@sveltejs/adapter-cloudflare": "^7.2.8",
    "@sveltejs/kit": "^2.21.0",
    "@sveltejs/vite-plugin-svelte": "^5.0.0",
    "@types/node": "^26.6.5",
    "svelte": "^5.0.0",
    "svelte-check": "^4.0.0",
    "tslib": "^2.6.0",
    "typescript": "^5.7.0",
    "vite": "^6.2.0",
    "wrangler": "^4.14.1"
  }
}
